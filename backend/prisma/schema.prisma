generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CareEventType {
  poop
  pee
  breastfeeding
  formula
  sleep
}

enum BreastSide {
  left
  right
  both
}

enum RecordSource {
  web
  pwa
}

enum FamilyRole {
  admin
  member
  viewer
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String?  @unique
  email        String?  @unique
  nickname     String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  babies        Baby[]
  records       CareRecord[]
  growthRecords GrowthRecord[]
  refreshTokens RefreshToken[]
  memberships   BabyMember[]
  createdCodes  InviteCode[]  @relation("inviteCreator")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Baby {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  name        String
  birthday    DateTime? @db.Date
  gender      String?
  birthWeight Float?    @map("birth_weight")
  birthHeight Float?    @map("birth_height")
  bloodType   String?   @map("blood_type")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  records     CareRecord[]
  growthRecords GrowthRecord[]
  members     BabyMember[]
  inviteCodes InviteCode[]

  @@index([ownerId])
  @@map("babies")
}

model BabyMember {
  id        String     @id @default(uuid()) @db.Uuid
  babyId    String     @map("baby_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      FamilyRole @default(member)
  joinedAt  DateTime   @default(now()) @map("joined_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([babyId, userId])
  @@index([userId])
  @@index([babyId])
  @@map("baby_members")
}

model InviteCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  babyId    String   @map("baby_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  expiresAt DateTime @map("expires_at")
  usedCount Int      @default(0) @map("used_count")
  maxUses   Int      @default(10) @map("max_uses")
  createdAt DateTime @default(now()) @map("created_at")

  baby    Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  creator User @relation("inviteCreator", fields: [createdBy], references: [id])

  @@index([babyId])
  @@map("invite_codes")
}

model CareRecord {
  id         String        @id @default(uuid()) @db.Uuid
  clientId   String        @unique @map("client_id")
  babyId     String        @map("baby_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  eventType  CareEventType @map("event_type")
  happenedAt DateTime      @map("happened_at")
  endedAt    DateTime?     @map("ended_at")
  duration   Int?
  side       BreastSide?
  amount     Int?
  note       String?
  source     RecordSource  @default(pwa)
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([babyId, happenedAt(sort: Desc)])
  @@index([userId, happenedAt(sort: Desc)])
  @@map("care_records")
}

model GrowthRecord {
  id                String       @id @default(uuid()) @db.Uuid
  clientId          String       @unique @map("client_id")
  babyId            String       @map("baby_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  measuredAt        DateTime     @map("measured_at") @db.Date
  weight            Float?       // kg，精度 0.01，范围 0.5-30
  heightCm          Float?       @map("height_cm")  // cm，精度 0.1，范围 30-150
  headCircumference Float?      @map("head_circumference") // cm，精度 0.1，范围 25-60
  note              String?
  source            RecordSource @default(pwa)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([babyId, measuredAt(sort: Desc)])
  @@map("growth_records")
}
